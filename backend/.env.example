# Copiar para .env e preencher. O .env NUNCA é commitado (.gitignore).
DJANGO_SECRET_KEY=troca-por-uma-chave-gerada-com-uv-run-python-c-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PokeAPI (TTLs em segundos)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_CACHE_TTL=604800
POKEAPI_LIST_CACHE_TTL=2592000

# Throttling DRF
DJANGO_THROTTLE_RATE=120/min
